<Window x:Name="WindowForm" x:Class="WpfAppПерваяПробаПера.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppПерваяПробаПера"
        mc:Ignorable="d"
        Title="Формошка Регистрации Юзверей (Зарегистрировано = " Height="490" Width="800" Background="#FFE9F4F4" FontSize="18" Loaded="WindowForm_Loaded" ResizeMode="NoResize">
    <Grid>
        <Label x:Name="LableNameUser" Content="Имя" HorizontalAlignment="Left" Margin="39,30,0,0" VerticalAlignment="Top" FontSize="18" Foreground="#FFA101F7"/>
        <Label x:Name="LableLastNameUser" Content="Фамилия" HorizontalAlignment="Left" Margin="39,130,0,0" VerticalAlignment="Top" FontSize="18" Foreground="#FFC500FB"/>
        <Label x:Name="LableAgeUser" Content="Возраст" HorizontalAlignment="Left" Margin="39,236,0,0" VerticalAlignment="Top" FontSize="18" Foreground="#FFCB20FA"/>
        <TextBox x:Name="TextBoxNameUser" HorizontalAlignment="Left" Margin="39,69,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="516" FontSize="18" ToolTip="Введите имя" BorderBrush="#FFD708F9" SelectionTextBrush="#FF01FD2D" SelectionBrush="#FF01FD2D" TextChanged="TextBoxNameUser_TextChanged" />
        <TextBox x:Name="TextBoxLastNameUser" HorizontalAlignment="Left" Margin="39,169,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="516" FontSize="18" ToolTip="Введите фамилию" BorderBrush="#FFF006F7" SelectionTextBrush="#FF01FD2D" SelectionBrush="#FF01FD2D" TextChanged="TextBoxLastNameUser_TextChanged" />
        <TextBox x:Name="TextBoxAgeUser" HorizontalAlignment="Left" Margin="39,275,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="516" FontSize="18" ToolTip="Введите возраст" BorderBrush="#FFFF0AE5" SelectionTextBrush="#FF01FD2D" SelectionBrush="#FF01FD2D" TextChanged="TextBoxAgeUser_TextChanged" />
        <Button x:Name="ButtonRegistrationUser" Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="39,380,0,0" VerticalAlignment="Top" FontSize="20" Width="361" Background="#FFA7C264" BorderBrush="#FFA900FB" Foreground="#FF9C13F6" Click="ButtonRegistrationUser_Click"/>
        <Button x:Name="ButtonTap" Content="Тапалка" HorizontalAlignment="Left" Margin="634,380,0,0" VerticalAlignment="Top" Background="#FF00B9FF" BorderBrush="#FFFDE800" Foreground="#FFB90BEF" Width="136" Height="31" Click="ButtonTap_Click"/>
    </Grid>
</Window>
