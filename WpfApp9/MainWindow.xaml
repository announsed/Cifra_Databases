<Window x:Class="WpfApp9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp9"
        xmlns:commands="clr-namespace:WpfApp9.Infrastructure.Commands"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Rectangle x:Name="RambowGradient" Grid.Row="0">
            
        </Rectangle>
        <StackPanel Grid.Row="1" Background="BlanchedAlmond">
            <RadioButton Content="Красный" Margin="12 20" Foreground="Red" FontFamily="Arial Rounded MT Bold" FontSize="15" Command="{Binding LineRedCommand}" CommandTarget="{Binding ElementName=RambowGradient}">
            </RadioButton>
            <RadioButton Content="Зеленый" Margin="12 20" Foreground="Green" FontFamily="Arial Rounded MT Bold" FontSize="15" Command="{Binding LineGreenCommand}" CommandTarget="{Binding ElementName=RambowGradient}">
            </RadioButton>
        </StackPanel>
    </Grid>
</Window>
