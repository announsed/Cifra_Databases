<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Canvas Width="400" Height="400">
            <Button x:Name="ButtonColor" Width="100" Height="100"  Canvas.Left="110" Canvas.Top="70" Canvas.ZIndex="0"/>
            <Rectangle Width="100" Height="100" Fill="Green" Canvas.Left="70" Canvas.Top="100" Canvas.ZIndex="2"/>
            <Rectangle Width="100" Height="100" Fill="Yellow" Canvas.Left="40" Canvas.Top="130" Canvas.ZIndex="1"/>
        </Canvas>
    </Grid>
    

</Window>
